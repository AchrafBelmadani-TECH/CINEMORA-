# CINEMORA server environment
# Copy to `.env` and fill in. NEVER commit real secrets.

# --- Phase 1 (required now) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# CORS whitelist — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 2 (TMDB integration) ---
# v4 read access token from https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# --- Phase 4 (database & auth) ---
# Local embedded Postgres by default; point at any managed Postgres in staging/prod.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Phase 6 (media & storage) ---
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# Optional overrides if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# --- Phase 6/8 (S3-compatible storage, production) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE=

# --- Phase 7 (first admin seed) ---
ADMIN_BOOTSTRAP_EMAIL=

# CINEMORA server environment
# Copy to `.env` and fill in. NEVER commit real secrets.

# --- Phase 1 (required now) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# CORS whitelist — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 2 (TMDB integration) ---
# v4 read access token from https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# --- Phase 4 (database & auth) ---
# Local dev: embedded Postgres managed by `npm run db:start` (127.0.0.1:5433).
# Staging/prod: point at any managed Postgres — this URL is standard.
DATABASE_URL=postgresql://cinemora@localhost:5433/cinemora
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Interim admin credential for the sync API until USER/ADMIN RBAC (Phase 5).
# Unset = admin sync API returns 503 (disabled). Minimum 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_TOKEN=

# --- Phase 6 (media & storage) ---
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# Optional overrides if ffmpeg/ffprobe are not on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# --- Phase 6/8 (S3-compatible storage, production) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE=

# --- Phase 7 (first admin seed) ---
ADMIN_BOOTSTRAP_EMAIL=
